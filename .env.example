# Absolute origin of the deployed site, without a trailing slash.
# Used for metadataBase, canonical URLs, robots.txt and sitemap.xml.
# While this variable is unset OR EMPTY/INVALID the site is treated as a
# development preview: crawlers are disallowed and pages are marked noindex
# (canonical/OG URLs then fall back to Vercel's deployment URL when building
# on Vercel, or to http://localhost:3000 locally).
#
# VERCEL: set this in Vercel → Project → Settings → Environment Variables for
# the Production (and Preview, if desired) environments, e.g.
#   NEXT_PUBLIC_SITE_URL="https://princemfurnishingconcept.com"
NEXT_PUBLIC_SITE_URL="https://example.com"
